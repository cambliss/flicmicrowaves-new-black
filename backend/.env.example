# PostgreSQL connection
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/flic_microwaves
# Set to true when your managed PostgreSQL requires SSL (common in hosting platforms)
DATABASE_SSL=false

# Server
PORT=4000

# JWT — change this to a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_string

# Admin credentials
ADMIN_USER=admin
# Generate a hash with: node -e "require('bcryptjs').hash('yourpassword',10).then(console.log)"
ADMIN_PASS_HASH=$2a$10$replacethiswitharealbcrypthash

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Production example:
# ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
